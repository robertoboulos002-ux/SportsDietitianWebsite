# Copy this file to .env and fill in your real values. Never commit .env itself.

PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sport_dietitian

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173

# Gmail SMTP - sends booking emails to both admin and client.
# Use a Google App Password, not your normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Admin alert recipient. If empty, admin alerts go to GMAIL_USER.
NOTIFY_EMAIL=

# Name clients see in the confirmation email.
BUSINESS_NAME=Sports Dietitian Coach

# Admin dashboard password for /admin and protected booking API routes.
ADMIN_PASSWORD=change-this-password

# Booking prices used in email and WhatsApp notifications.
PRICE_CONSULTATION=$120
PRICE_BODY_COMPOSITION=$75

# Optional WhatsApp Cloud API notification settings.
# Fill these if you want booking alerts sent to WhatsApp too.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
